#!/bin/sh
# unredacted-rpi5-boot preinst: refuse to install anywhere but a Raspberry Pi 5
# Model B or a Compute Module 5 (BOARDS_RE in unredacted-rpi5-boot).
#
# The hardened pi5 kernel is built for the BCM2712 and boots only via its
# firmware; this package is what makes it boot, so this is where a wrong
# machine is stopped. Image builders working in a chroot on another host can
# set UNREDACTED_RPI5_BOOT_SKIP_MODEL_CHECK=1.
set -e
case "$1" in
    install|upgrade)
        if [ "${UNREDACTED_RPI5_BOOT_SKIP_MODEL_CHECK:-}" != 1 ]; then
            dt="${UNREDACTED_RPI5_BOOT_ROOT:-}/proc/device-tree/compatible"
            if ! { [ -r "$dt" ] && tr '\0' '\n' < "$dt" | grep -qxE 'raspberrypi,(5-model-b|5-compute-module)'; }; then
                echo "unredacted-rpi5-boot: this machine is not a Raspberry Pi 5 or Compute Module 5" >&2
                echo "  (/proc/device-tree/compatible lists neither raspberrypi,5-model-b nor raspberrypi,5-compute-module)." >&2
                echo "  The hardened pi5 kernel is for those boards only; refusing to install." >&2
                exit 1
            fi
        fi
        ;;
esac
exit 0
