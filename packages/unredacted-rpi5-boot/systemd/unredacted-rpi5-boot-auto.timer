# Opt-in auto-upgrade ('unredacted-rpi5-boot auto-upgrade on'): two minutes
# after every boot, start unredacted-rpi5-boot-auto.service. On the trial boot
# of a kernel auto-upgrade armed, that verifies and promotes it, or reboots
# back; on a normal boot it arms a newer staged kernel, if there is one. The
# service does nothing unless auto-upgrade is on or a trial is armed.
[Unit]
Description=Hardened kernel auto-upgrade, after boot
Documentation=file:/usr/share/doc/unredacted-rpi5-boot/README.md

[Timer]
OnBootSec=2min
AccuracySec=1s

[Install]
WantedBy=timers.target
