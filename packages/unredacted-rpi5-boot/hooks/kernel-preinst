#!/bin/sh
# /etc/kernel/preinst.d/z70-unredacted-rpi5-boot (unredacted-rpi5-boot)
#
# Before a hardened Pi 5 kernel package is unpacked: fingerprint the stock
# boot files, so the postinst.d hook can tell whether installing it touched
# them. Other kernels: nothing.
set -e
version="$1"
case "$version" in *-hardened-unredacted-pi5) ;; *) exit 0 ;; esac
tool="${UNREDACTED_RPI5_BOOT_ROOT:-}/usr/sbin/unredacted-rpi5-boot"
[ -x "$tool" ] || exit 0
if [ -n "${DEB_MAINT_PARAMS:-}" ]; then
    eval set -- "$DEB_MAINT_PARAMS"
    case "$1" in install|upgrade) ;; *) exit 0 ;; esac
fi
exec "$tool" snapshot "$version" </dev/null >&2
