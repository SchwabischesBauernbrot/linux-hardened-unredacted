# Project intent overlay, x86_64 fragment: pins that only exist on x86.
#
# Merged after configs/intent.common.config by build/configure-kernel.sh for
# every flavor whose descriptor lists it (today: amd64). Same rules as the
# common fragment: every CONFIG line here must land verbatim in the final
# .config, each symbol is pinned by exactly one fragment of a flavor, and
# every symbol needs a rationale entry in configs/POLICY.md.
#
# These were split out of the single intent.config unchanged, so they keep
# the layer they had there: all are defense-in-depth insurance pins that
# anthraxx's config.x86_64 already sets the same way, except
# MODIFY_LDT_SYSCALL, which is attack-surface reduction.

# --- Memory safety: KASLR of the direct map, vmalloc and vmemmap ---
CONFIG_RANDOMIZE_MEMORY=y

# --- Attack-surface reduction (off) ---
# CONFIG_MODIFY_LDT_SYSCALL is not set
CONFIG_LEGACY_VSYSCALL_NONE=y

# --- CPU speculation mitigations (structural three) ---
# The CPU_MITIGATIONS master is pinned in the common fragment; these are the
# low-churn structural x86 mitigations under it.
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y

# --- Control-flow integrity (x86 CET) ---
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y

# --- User-mode instruction prevention ---
CONFIG_X86_UMIP=y
