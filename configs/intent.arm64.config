# Project intent overlay, arm64 fragment: pins for every arm64 flavor.
#
# Merged after configs/intent.common.config by build/configure-kernel.sh for
# every flavor whose descriptor lists it (today: pi5; a generic arm64 flavor
# would list it too). Same rules as the common fragment: every CONFIG line
# here must land verbatim in the final .config, each symbol is pinned by
# exactly one fragment of a flavor, and every symbol needs a rationale entry
# in configs/POLICY.md.
#
# The arm64 seeds are distro configs (Raspberry Pi OS's for pi5), not
# anthraxx's hardened config, so several positions amd64 INHERITS from its seed
# have to be pinned here instead. Pins that depend on the page size or on the
# board live in the flavor's own fragment (configs/intent.pi5.config).

# --- Control-flow integrity: shadow call stack ---
# Cortex-A76 (Pi 5) has no pointer authentication, BTI or MTE, so the PAC/BTI
# kernel features the seed enables do nothing there. The software shadow call
# stack protects return addresses on any arm64 CPU.
CONFIG_SHADOW_CALL_STACK=y

# --- Kernel page-table isolation (KPTI) ---
CONFIG_UNMAP_KERNEL_AT_EL0=y

# --- Boot image ---
# Raspberry Pi firmware boots Image.gz directly, and sign-debs.sh does not
# sign arm64 images; the EFI zboot PE wrapper would only change the image
# format under /boot.
# CONFIG_EFI_ZBOOT is not set

# --- LSMs and BPF ---
# configs/intent.common.config's CONFIG_LSM lists "bpf", which only activates
# with BPF_LSM. amd64 inherits it from anthraxx's seed; the arm64 seeds lack it.
CONFIG_BPF_LSM=y
# Kernel BTF, as amd64 ships: systemd's bpf-restrict-fs and other BPF LSM
# programs need it (on the 2026-11-02 Pi trial, without BTF that unit failed).
# BTF is generated from DWARF, so debug info goes on, in the same format as
# amd64's (DWARF 5, uncompressed, not reduced or split).
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_NONE is not set

# --- Module loading ---
# The common fragment compresses modules (MODULE_COMPRESS_XZ) and enforces
# LoadPin. With compressed modules, LOADPIN_ENFORCE depends on the kernel
# decompressing them itself (finit_module), so in-kernel decompression is
# required, as on amd64.
CONFIG_MODULE_DECOMPRESS=y

# --- mmap ASLR for 32-bit (compat) processes ---
# 16 is the arm64 maximum at every page size. The 64-bit
# ARCH_MMAP_RND_BITS maximum depends on the page size and VA width, so the
# flavor fragment pins it.
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16

# --- Positions amd64 inherits from anthraxx's seed ---
# Found by the pi5 inherited-gap audit (docs/operators/pi5-inherited-gap-audit.md):
# anthraxx's config sets these, a distro arm64 config does not.
#
# No BPF interpreter: every BPF program is JIT-compiled, removing the
# interpreter as a speculative-execution gadget.
CONFIG_BPF_JIT_ALWAYS_ON=y
# Sanity-check virt_to_phys() arguments (catches bad address arithmetic that
# would otherwise silently map the wrong page).
CONFIG_DEBUG_VIRTUAL=y
# Keep the lowest 32K of user address space unmappable, so a kernel NULL
# dereference cannot be steered into user-controlled memory. The arm64 default
# with COMPAT; Raspberry Pi's config lowers it to 4096.
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
# debugfs registered but neither mountable nor reachable: it exposes kernel
# internals no production host needs.
CONFIG_DEBUG_FS_ALLOW_NONE=y
# CONFIG_DEBUG_FS_ALLOW_ALL is not set
# SysRq off until something enables it (kernel.sysrq); a serial-console break
# should not be able to trigger it on a remote host.
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# No in-kernel debugger.
# CONFIG_KGDB is not set
# No SCTP: any local user can autoload the protocol module with socket(2),
# and it has a long CVE record. Nothing on the target hosts uses it.
# CONFIG_IP_SCTP is not set
