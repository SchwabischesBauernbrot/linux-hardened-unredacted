# Project intent overlay: pinned kernel-config positions.
#
# This file is merged on top of the upstream seed (anthraxx's Arch
# linux-hardened config.x86_64, pinned in configs/upstream-seed.toml)
# by build/configure-kernel.sh. After the merge + `make olddefconfig`,
# every CONFIG line in this file is asserted to appear verbatim in the
# final .config. A miss aborts the configure step (fail-fast at ~2 min,
# not 30+ min into compile).
#
# Two layers, all rationale in configs/POLICY.md:
#
#   1) Genuine deltas where we diverge from anthraxx's seed (17 lines).
#      Examples: MODULE_SIG_FORCE (we require signed modules; they don't
#      enforce), LOCK_DOWN_KERNEL_FORCE_INTEGRITY (we ship integrity
#      mode; they ship FORCE_NONE), our SHA256+RSA module-signing crypto
#      vs their SHA512+ECDSA, latent_entropy off (reproducibility),
#      MODULE_COMPRESS_XZ vs their ZSTD, the Docker NAT module pair.
#
#   2) Defense-in-depth insurance pins (75 lines).
#      Every POLICY-tracked hardening symbol gets pinned EVEN IF
#      anthraxx already sets it the way we want. Insurance against a
#      future seed bump silently regressing one of these. The fidelity
#      check catches any silent drop at configure time.
#
# Symbols NOT in this file (e.g. SECURITY_LOADPIN, SECURITY_SAFESETID,
# KFENCE_DEFERRABLE) are inherited from anthraxx's seed by design —
# that's the upside of seeding from a curated hardened reference rather
# than re-deriving from a generic stock distro config.

# ============================================================
# DELTAS — where we diverge from anthraxx's seed
# ============================================================

# --- Lockdown: integrity mode, enforced early in boot ---
# anthraxx ships LOCK_DOWN_KERNEL_FORCE_NONE (no lockdown enforced).
# We ship integrity-mode lockdown enforced from boot under Secure Boot.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y

# --- Module signature enforcement ---
# anthraxx has MODULE_SIG=y but does NOT FORCE. We require signed
# modules (an unsigned out-of-tree module won't load).
CONFIG_MODULE_SIG_FORCE=y

# --- Module signing crypto ---
# anthraxx uses ECDSA + SHA512. We use RSA + SHA256: more broadly
# compatible with downstream verifiers (older shim chains, etc.),
# cryptographically sufficient for the threat model.
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
# CONFIG_MODULE_SIG_KEY_TYPE_ECDSA is not set
CONFIG_MODULE_SIG_SHA256=y

# --- Module compression ---
# anthraxx compresses with ZSTD. We use XZ. Revisit when
# tools/strip-signatures.sh is fixed to handle compressed modules
# (task #47); until then both compressions have the same caveat.
CONFIG_MODULE_COMPRESS_XZ=y
# CONFIG_MODULE_COMPRESS_ZSTD is not set

# --- GCC plugin: latent_entropy off ---
# anthraxx enables CONFIG_GCC_PLUGIN_LATENT_ENTROPY. We disable.
# Marginal benefit on x86_64+RDRAND; breaks bit-for-bit reproducible
# builds (the plugin injects compile-time randomness). Reproducibility
# is this project's primary defense against its online-signing-key
# weakness, so we keep clean repro over the marginal entropy gain.
# CONFIG_GCC_PLUGIN_LATENT_ENTROPY is not set

# --- Per-target: container NAT (Docker / Podman) ---
# anthraxx doesn't pin these because their audience may not run
# container runtimes; we do. The 6.12 → 7.0 Kconfig refactor removed
# the symbol that used to select these as a side-effect of NF_NAT,
# so we set them explicitly.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m

# --- USERFAULTFD: compiled out (now matches anthraxx) ---
# Previously shipped on with sysctl unprivileged_userfaultfd=0; now
# compiled out entirely (anthraxx's posture), removing a use-after-free
# exploitation primitive for all privilege levels. Safe for our
# deployment: CRIU is already off (CHECKPOINT_RESTORE), and userfaultfd
# for QEMU post-copy live migration is a hypervisor-host facility — our
# hypervisors run a stock kernel; the hardened kernel runs only as a
# guest. olddefconfig also drops HAVE_ARCH_USERFAULTFD_WP /
# PTE_MARKER_UFFD_WP. No longer a divergence; pinned off as insurance.
# CONFIG_USERFAULTFD is not set

# --- Module signing key path (a FIXED in-tree path) ---
# configure-kernel.sh copies the project signing key (materialized from the
# KERNEL_SIGNING_KEY secret) to exactly this path inside the kernel tree. The
# value is therefore a CONSTANT: identical on every build and on any
# rebuilder's machine, so it is the value the fidelity assertion checks AND
# the value that ships.
#
# It previously held the kernel's stock placeholder while configure-kernel.sh
# rewrote it, after the fidelity check, to a per-build `mktemp -d` path. That
# rewrite was applied to the TREE's .config -- which bindeb-pkg then ships as
# /boot/config-<rel>, embeds via CONFIG_IKCONFIG into /proc/config.gz, and
# packages in the headers .deb; only the separately-captured final.config was
# normalized. Confirmed by reading this symbol out of /proc/config.gz on a
# running v7.1.x machine: it held a runner mktemp directory name. So every
# kernel up to v7.1.4 published that path, and two runs of the same tag were
# never bit-identical. (The literal value is deliberately not quoted here --
# this file is merged into .config, and a string that looks like a leaked path
# has no business anywhere near the shipped config. See configs/POLICY.md.)
#
# NOT the stock `certs/signing_key.pem`: upstream certs/Makefile guards a
# FORCE + if_changed,gen_key rule with `ifeq ($(CONFIG_MODULE_SIG_KEY),
# certs/signing_key.pem)`, so under the default name kbuild would REGENERATE
# our pre-placed key with a fresh random one -- shipping a kernel that trusts a
# key nobody holds. That name is also on MRPROPER_FILES. With a non-default
# name the generator rule does not exist, so a missing key fails loudly
# ("No rule to make target") instead of silently producing an ephemeral-key
# kernel. build-debs.sh additionally asserts the embedded cert is ours.
CONFIG_MODULE_SIG_KEY="certs/unredacted-signing.pem"

# ============================================================
# INSURANCE — defense-in-depth pins
# Every POLICY-tracked symbol below should already match anthraxx's seed
# today; pinning them explicitly means
# a future seed bump cannot silently regress any of them: the fidelity
# assertion fires the moment one fails to land.
# ============================================================

# --- Memory safety ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SLAB_CANARY=y
CONFIG_PAGE_SANITIZE_VERIFY=y
CONFIG_SLAB_SANITIZE_VERIFY=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_KFENCE=y
CONFIG_KFENCE_BUG_ON_DATA_CORRUPTION=y
CONFIG_MSEAL_SYSTEM_MAPPINGS=y

# --- Control flow / stack ---
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- GCC plugins (need gcc-<ver>-plugin-dev in the build container) ---
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_KSTACK_ERASE=y
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
# CONFIG_GCC_PLUGIN_STRUCTLEAK is not set

# --- Kernel + module integrity ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_SECURITY_LOCKDOWN_LSM=y

# --- Attack-surface reduction (off) ---
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y

# --- Misc hardening ---
CONFIG_PANIC_ON_OOPS=y
CONFIG_DEBUG_LIST=y
CONFIG_LIST_HARDENED=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_SCHED_STACK_END_CHECK=y

# ============================================================
# INHERITED-HARDENING INSURANCE PINS (added 2026-06-16)
# Every symbol below is already set identically by anthraxx's seed and
# present in the shipped final.config; pinned here so a future seed bump
# cannot silently drop one (closing the gap where these were guarded only
# by tools/check-hardening-drift.sh, not the fidelity assertion).
# Rationale per group in configs/POLICY.md.
# ============================================================

# --- CPU speculation mitigations (structural master + core) ---
# The per-CPU-vulnerability mitigation symbols (SRSO, GDS, RFDS,
# SPECTRE_BHI, ...) are deliberately NOT pinned: they churn every kernel
# release and are gated by CPU_MITIGATIONS below. Pinning the master plus
# the structural three is the high-value, low-churn insurance.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y

# --- LSM stack (active ordering + stacked LSMs) ---
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_ENFORCE=y
CONFIG_SECURITY_SAFESETID=y

# --- Control-flow integrity (x86 CET) ---
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y

# --- DMA protection (IOMMU strict, no passthrough) ---
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set

# --- Unprivileged-access compile-time backstops ---
# Compile-time halves of the unprivileged_bpf_disabled / userns sysctls.
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
# CONFIG_USER_NS_UNPRIVILEGED is not set

# --- Heap hardening companions ---
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SLAB_BUCKETS=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y

# --- Stack protector parent + misc ---
CONFIG_STACKPROTECTOR=y
CONFIG_X86_UMIP=y
CONFIG_RESET_ATTACK_MITIGATION=y

# ============================================================
# ADDITIONAL HARDENING — beyond anthraxx (added 2026-06-16)
# Net-new flips anthraxx does not set; zero-risk for our targets.
# These diverge from anthraxx (counted with the deltas, not insurance).
# ============================================================

# Zero call-clobbered GPRs on function return (ROP/leak mitigation).
# gcc-supported (CC_HAS_ZERO_CALL_USED_REGS), deterministic/reproducible.
CONFIG_ZERO_CALL_USED_REGS=y

# Drop the FOLL_FORCE override path for /proc/<pid>/mem writes.
CONFIG_PROC_MEM_NO_FORCE=y

# Remove `insmod --force` (vermagic bypass). Signature enforcement
# (MODULE_SIG_FORCE) is unaffected; DKMS does not use --force.
# CONFIG_MODULE_FORCE_LOAD is not set

# Latent SELinux hardening: SELinux is compiled in but not in our active
# LSM stack, so these only matter if it is ever enabled — cheap to pin.
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
