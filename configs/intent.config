# Project intent overlay: pinned kernel-config positions.
#
# This file is merged on top of the upstream seed (anthraxx's Arch
# linux-hardened config.x86_64, pinned in configs/upstream-seed.toml)
# by build/configure-kernel.sh. After the merge + `make olddefconfig`,
# every CONFIG line in this file is asserted to appear verbatim in the
# final .config. A miss aborts the configure step (fail-fast at ~2 min,
# not 30+ min into compile).
#
# Two layers, all rationale in configs/POLICY.md:
#
#   1) Genuine deltas where we diverge from anthraxx's seed (~10 lines).
#      Examples: MODULE_SIG_FORCE (we require signed modules; they don't
#      enforce), LOCK_DOWN_KERNEL_FORCE_INTEGRITY (we ship integrity
#      mode; they ship FORCE_NONE), our SHA256+RSA module-signing crypto
#      vs their SHA512+ECDSA, latent_entropy off (reproducibility),
#      MODULE_COMPRESS_XZ vs their ZSTD, the Docker NAT module pair.
#
#   2) Defense-in-depth insurance pins (~50 lines).
#      Every POLICY-tracked hardening symbol gets pinned EVEN IF
#      anthraxx already sets it the way we want. Insurance against a
#      future seed bump silently regressing one of these. The fidelity
#      check catches any silent drop at configure time.
#
# Symbols NOT in this file (e.g. SECURITY_LOADPIN, SECURITY_SAFESETID,
# KFENCE_DEFERRABLE) are inherited from anthraxx's seed by design —
# that's the upside of seeding from a curated hardened reference rather
# than re-deriving from a generic stock distro config.

# ============================================================
# DELTAS — where we diverge from anthraxx's seed
# ============================================================

# --- Lockdown: integrity mode, enforced early in boot ---
# anthraxx ships LOCK_DOWN_KERNEL_FORCE_NONE (no lockdown enforced).
# We ship integrity-mode lockdown enforced from boot under Secure Boot.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y

# --- Module signature enforcement ---
# anthraxx has MODULE_SIG=y but does NOT FORCE. We require signed
# modules (an unsigned out-of-tree module won't load).
CONFIG_MODULE_SIG_FORCE=y

# --- Module signing crypto ---
# anthraxx uses ECDSA + SHA512. We use RSA + SHA256: more broadly
# compatible with downstream verifiers (older shim chains, etc.),
# cryptographically sufficient for the threat model.
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
# CONFIG_MODULE_SIG_KEY_TYPE_ECDSA is not set
CONFIG_MODULE_SIG_SHA256=y

# --- Module compression ---
# anthraxx compresses with ZSTD. We use XZ. Revisit when
# tools/strip-signatures.sh is fixed to handle compressed modules
# (task #47); until then both compressions have the same caveat.
CONFIG_MODULE_COMPRESS_XZ=y
# CONFIG_MODULE_COMPRESS_ZSTD is not set

# --- GCC plugin: latent_entropy off ---
# anthraxx enables CONFIG_GCC_PLUGIN_LATENT_ENTROPY. We disable.
# Marginal benefit on x86_64+RDRAND; breaks bit-for-bit reproducible
# builds (the plugin injects compile-time randomness). Reproducibility
# is this project's primary defense against its online-signing-key
# weakness, so we keep clean repro over the marginal entropy gain.
# CONFIG_GCC_PLUGIN_LATENT_ENTROPY is not set

# --- Per-target: container NAT (Docker / Podman) ---
# anthraxx doesn't pin these because their audience may not run
# container runtimes; we do. The 6.12 → 7.0 Kconfig refactor removed
# the symbol that used to select these as a side-effect of NF_NAT,
# so we set them explicitly.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_NAT=m

# --- USERFAULTFD: preserve current behaviour ---
# anthraxx compiles userfaultfd out entirely. We currently ship it on
# with the sysctl restriction unprivileged_userfaultfd=0. Keeping our
# current posture for now (potential follow-up: adopt anthraxx's =n
# after auditing user-infra compatibility — CRIU is already off, but
# some container runtimes / live-migration tools use userfaultfd).
CONFIG_USERFAULTFD=y

# --- Module signing key path (placeholder) ---
# anthraxx's path doesn't apply to us. configure-kernel.sh
# sed-replaces this AFTER the fidelity check with a CI-runtime tmpfs
# path materialized from the project signing-key secret. The post-
# fidelity timing keeps the runtime path out of the drift check.
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# ============================================================
# INSURANCE — defense-in-depth pins
# Every POLICY-tracked symbol below SHOULD already match the seed
# (per the current diff, 58 of 59 do). Pinning them explicitly means
# a future seed bump cannot silently regress any of them: the fidelity
# assertion fires the moment one fails to land.
# ============================================================

# --- Memory safety ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SLAB_CANARY=y
CONFIG_PAGE_SANITIZE_VERIFY=y
CONFIG_SLAB_SANITIZE_VERIFY=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_KFENCE=y
CONFIG_KFENCE_BUG_ON_DATA_CORRUPTION=y
CONFIG_MSEAL_SYSTEM_MAPPINGS=y

# --- Control flow / stack ---
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- GCC plugins (need gcc-<ver>-plugin-dev in the build container) ---
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_KSTACK_ERASE=y
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
# CONFIG_GCC_PLUGIN_STRUCTLEAK is not set

# --- Kernel + module integrity ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_SECURITY_LOCKDOWN_LSM=y

# --- Attack-surface reduction (off) ---
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y

# --- Misc hardening ---
CONFIG_PANIC_ON_OOPS=y
CONFIG_DEBUG_LIST=y
CONFIG_LIST_HARDENED=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_SCHED_STACK_END_CHECK=y
