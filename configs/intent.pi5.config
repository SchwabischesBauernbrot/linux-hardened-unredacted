# Project intent overlay, pi5 fragment: pins for the Raspberry Pi 5 flavor.
#
# Merged after configs/intent.common.config and configs/intent.arm64.config by
# build/configure-kernel.sh for the pi5 flavor (configs/flavors/pi5.toml),
# over Raspberry Pi OS's packaged rpi-2712 config (configs/seeds/pi5/6.18.toml)
# on Raspberry Pi's rpi-6.18.y tree. Same rules as the other fragments: every
# CONFIG line here must land verbatim in the final .config, each symbol is
# pinned by exactly one fragment of a flavor, and every symbol needs a
# rationale entry in configs/POLICY.md.

# --- Kernel release name ---
# The seed carries LOCALVERSION="-v8-16k"; the flavor's localversion
# (-hardened-unredacted-pi5) is the only suffix. The kernelrelease must never
# contain "-rpi": Raspberry Pi OS's z50-raspi-firmware kernel hook would treat
# it as a stock kernel and copy its DTBs over /boot/firmware.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# --- Memory layout: 16K pages, NUMA emulation ---
# 16K pages are what Raspberry Pi ships for the Pi 5 and measurably faster on
# it. The firmware passes numa=fake=8 numa_policy=interleave, which spreads
# memory across the SDRAM banks (Igalia measured +6% single-core, +18%
# multi-core); it needs NUMA emulation built in.
CONFIG_ARM64_16K_PAGES=y
CONFIG_NUMA=y
CONFIG_NUMA_EMU=y

# --- mmap ASLR ---
# The maximum with 16K pages and 47-bit VA (the seed's default is 18).
CONFIG_ARCH_MMAP_RND_BITS=30

# --- Preemption ---
# Full preemption as the seed has it, plus PREEMPT_DYNAMIC so preempt=lazy can
# be tried on the relays from the kernel command line without a rebuild.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# --- Heap hardening: randomized kmalloc caches (6.18 name) ---
# The position configs/intent.v7_2.config pins as KMALLOC_PARTITION_CACHES
# for 7.2 and later, under its pre-7.2 name. Raspberry Pi's seed has it off.
# Replace this with intent.v7_2.config in the descriptor when the pi5 line
# moves to 7.2 or newer.
CONFIG_RANDOM_KMALLOC_CACHES=y

# --- VideoCore userspace interfaces (off) ---
# /dev/vcio passes any firmware mailbox property list to the VideoCore with no
# filtering, and /dev/vc-mem maps VideoCore memory: both give root a path
# around lockdown=integrity. vcgencmd stops working; EEPROM updates and the
# temperature sensor do not need it (docs/operators/flavors.md, decision 4).
# CONFIG_BCM_VCIO is not set
# CONFIG_BCM2708_VCMEM is not set
# /dev/vchiq hands userspace the VideoCore's message interface (the MMAL
# camera/codec services), which the Pi 5 does not use for its camera or
# display; in-kernel VCHIQ clients are unaffected.
# CONFIG_VCHIQ_CDEV is not set

# --- Pi 5 platform drivers the root filesystem and network depend on ---
# Built in, so the relay boots without an initramfs carrying them, and pinned
# so a seed bump that moves one to a module (or drops it) fails the build
# instead of the boot. BCM2712 SoC and its PCIe root port; RP1 (the I/O chip
# behind PCIe) with its pin and clock controllers; the Ethernet MAC on RP1;
# the SD/eMMC host; NVMe; firmware mailbox, power domains and watchdog
# (reboot, including the tryboot flag).
CONFIG_ARCH_BCM2835=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_BCM2712_MIP=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_MFD_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_MACB=y
CONFIG_BROADCOM_PHY=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_BLK_DEV_NVME=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_BCM2835_WDT=y
