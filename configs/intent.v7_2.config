# Project intent overlay, 7.2 fragment: pins whose symbols only exist from
# kernel 7.2 on.
#
# Merged after configs/intent.common.config by build/configure-kernel.sh for
# every flavor whose line set is on 7.2 or newer (today: amd64). They are
# common positions; only the symbol names are series-specific. A flavor on an
# older series pins the same position under the older name in its own
# fragment (pi5 on 6.18: CONFIG_RANDOM_KMALLOC_CACHES in intent.pi5.config),
# and lists this fragment instead once it moves to 7.2 or newer. Same rules as
# the other fragments: every CONFIG line here must land verbatim in the final
# .config, each symbol is pinned by exactly one fragment of a flavor, and
# every symbol needs a rationale entry in configs/POLICY.md.

# --- Heap hardening: randomized kmalloc caches ---
# 7.2 renamed RANDOM_KMALLOC_CACHES -> KMALLOC_PARTITION_CACHES (+ a mode
# choice); the old symbol is a transitional stub. Pin the mode too so a
# compiler that grows alloc-token support cannot silently switch it.
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
