# Kernel config fragment: linux-hardened hardening overlay.
#
# This file is merged on top of the distro stock config via
# scripts/kconfig/merge_config.sh. Every option here has a corresponding
# entry in POLICY.md.
#
# Reconcile this fragment against the upstream linux-hardened recommended
# config on every kernel-version bump (a release may add or remove
# symbols). Last reconciled against the upstream linux-hardened
# v7.0.9-hardened1 config as shipped by Arch. Symbols the patch defaults on
# are pinned explicitly here so our hardening posture is declared and
# audited, not silently inherited.
#
# Build-time dependency: CONFIG_GCC_PLUGINS (below) needs the
# gcc-<ver>-plugin-dev package in the build container — see
# .forgejo/workflows/build-kernel.yml. Without it, kconfig hides the entire
# plugin subtree and every plugin option here is silently dropped.

# --- Memory safety ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
# Disable slab merging. It reuses one cache across unrelated allocation
# sites, which weakens use-after-free containment, and the linux-hardened
# SLAB_CANARY option below is hidden unless merging is off. The Debian seed
# forces it on (=y), so we must override it back off here.
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SLAB_CANARY=y
CONFIG_PAGE_SANITIZE_VERIFY=y
CONFIG_SLAB_SANITIZE_VERIFY=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_KFENCE=y
CONFIG_KFENCE_BUG_ON_DATA_CORRUPTION=y
# Seal the kernel's special mappings (vdso/vvar/etc.) at exec so a compromised
# userspace can't mprotect/munmap them. Mainline hardening default on x86_64;
# matches the upstream linux-hardened reference config. Low compat risk: CRIU
# (the main remap-system-mappings consumer) is already off below.
CONFIG_MSEAL_SYSTEM_MAPPINGS=y

# --- Control flow / stack ---
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- GCC plugins (need gcc-<ver>-plugin-dev in the build container) ---
# Without the plugin-dev package kconfig drops this whole subtree, so the
# options must be declared here AND the package installed in build-kernel.yml.
CONFIG_GCC_PLUGINS=y
# Kernel stack-erase = a feature (KSTACK_ERASE) implemented by a GCC plugin
# (GCC_PLUGIN_STACKLEAK). Upstream 6.16 added the KSTACK_ERASE feature symbol
# and renamed the *sub-options* (STACKLEAK_* -> KSTACK_ERASE_*) but kept the
# plugin symbol itself. Confirmed coexistent in the 7.0.x tree (the prior
# build's olddefconfig auto-enabled the plugin via KSTACK_ERASE=y). Declare
# both so the fidelity assertion sees them land AND the new-symbol guard sees
# them as classified.
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_KSTACK_ERASE=y
# Pin the stack-erase runtime knobs off (their upstream-hardened default):
# METRICS is debug overhead, and RUNTIME_DISABLE would expose a boot flag to
# turn the protection off. They only appear once the plugin is built.
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
# latent_entropy is deliberately OFF -- a small, reasoned divergence from
# upstream. Its early-boot entropy benefit is marginal on x86_64 + RDRAND,
# and it injects build-time randomness that breaks bit-for-bit reproducible
# builds, which this project's trust model values more. See POLICY.md.
# CONFIG_GCC_PLUGIN_LATENT_ENTROPY is not set
# Stack variables are already zero-initialised by INIT_STACK_ALL_ZERO (a
# compiler builtin), so the older structleak plugin is redundant; leave it
# off. RANDSTRUCT stays at the kernel default (off) to avoid a
# rebuild-fragile struct ABI, matching upstream linux-hardened.
# CONFIG_GCC_PLUGIN_STRUCTLEAK is not set

# --- Kernel + module integrity ---
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# --- Attack-surface reduction (off) ---
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# Hibernation writes an unverified kernel image to swap; lockdown integrity
# blocks it at runtime anyway and upstream linux-hardened compiles it out.
# The Debian seed turns it on, so override off. Suspend-to-RAM is unaffected.
# CONFIG_HIBERNATION is not set
# CRIU checkpoint/restore exposes extra process-introspection surface and is
# off in upstream linux-hardened; the Debian seed enables it.
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y

# --- Misc hardening ---
CONFIG_PANIC_ON_OOPS=y
CONFIG_DEBUG_LIST=y
CONFIG_LIST_HARDENED=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_SCHED_STACK_END_CHECK=y
